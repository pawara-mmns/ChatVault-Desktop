{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main local window may check backend health and use validated storage operations. No SQL, generic dialog, or filesystem endpoints are granted.",
  "windows": ["main"],
  "permissions": [
    "allow-health-check",
    "allow-get-storage-overview",
    "allow-initialize-vault",
    "allow-choose-vault-directory",
    "allow-select-import-file",
    "allow-analyze-import",
    "allow-confirm-import",
    "allow-cancel-import",
    "allow-list-archives",
    "allow-get-archive-summary",
    "allow-list-conversations",
    "allow-get-conversation",
    "allow-read-messages",
    "allow-get-message-context",
    "allow-search-messages",
    "allow-list-conversation-media",
    "allow-get-media-metadata",
    "allow-authorize-media",
    "allow-revoke-media",
    "allow-open-document",
    "allow-list-connected-devices",
    "allow-refresh-connected-devices",
    "allow-get-device-details",
    "allow-check-device-file-access",
    "allow-discover-whatsapp-storage",
    "allow-cancel-device-operation",
    "allow-get-known-devices",
    "allow-remember-device",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-prepare-backup",
    "allow-get-backup-plan-files",
    "allow-start-backup",
    "allow-get-backup-progress",
    "allow-cancel-backup",
    "allow-list-backup-snapshots",
    "allow-get-backup-files",
    "allow-reverify-backup",
    "allow-cleanup-backup-staging",
    "allow-open-backup-location"
  ]
}
